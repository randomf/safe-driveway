# Tasks for the Safe Driveway remote device. Run `just` to list them.
#
# The board's serial port is found automatically. When more than one is
# connected, choose with DEVICE_PORT, for example:
#   DEVICE_PORT=/dev/ttyUSB1 just bringup

set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

_default:
    @just --list --unsorted

# Check that this computer is ready to work with the board
[no-exit-message]
doctor:
    @uv run python -m host.doctor

# Erase the board and write the pinned MicroPython; [--yes] skips the question, [FIRMWARE] writes another image
[no-exit-message, positional-arguments, unix]
flash *args:
    @uv run python -m host.flash "$@"

# PowerShell can't take positional arguments, so a FIRMWARE path can't contain spaces here.
[no-exit-message, windows]
flash *args:
    @uv run python -m host.flash {{ args }}

# Open the MicroPython REPL on the board with board/ mounted (leave with Ctrl-] or Ctrl-X)
[no-exit-message]
repl:
    @uv run python -m host.repl

# Show the distance the sensor measures, live, until Ctrl-C
[no-exit-message]
distance:
    @uv run python -m host.distance

# Run the guided bring-up test: all checks, or only those named (board sensor distance view leds buzzer battery)
[no-exit-message]
bringup *checks:
    @uv run python -m host.bringup {{ checks }}

# Install the firmware, which then starts whenever the unit is switched on
[no-exit-message]
install:
    @uv run python -m host.install

# Show what the firmware prints over USB, until Ctrl-C; [--reset] starts the board as if switched on
[no-exit-message]
monitor *args:
    @uv run python -m host.monitor {{ args }}

# Act as the phone over this computer's Bluetooth: scan, watch, setup, identify, unlock, set-pin, forget
[no-exit-message, positional-arguments, unix]
ble *args:
    @uv run python -m host.ble "$@"

# PowerShell can't take positional arguments, so a passage name can't contain spaces here.
[no-exit-message, windows]
ble *args:
    @uv run python -m host.ble {{ args }}

# Run the tests of the firmware's pure logic on this computer
[no-exit-message]
test *args:
    @uv run pytest {{ args }}

# Install MicroPython type stubs so editors understand the code in board/
[no-exit-message]
stubs:
    @uv run python -m host.stubs

# Check that the parts fit in the 3D-printed enclosure and write its print files and pictures
[no-exit-message]
enclosure:
    @uv run --group cad python -m enclosure

# Check code style without changing anything
[no-exit-message]
lint:
    @uv run ruff check
    @uv run ruff format --check

# Format the code and fix what ruff can fix by itself
fmt:
    @uv run ruff format
    @uv run ruff check --fix
