root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# Batch files need Windows line endings, as in .gitattributes.
[*.bat]
end_of_line = crlf

[*.{kt,kts}]
# The style Android Studio formats code in, so that its formatter and `just lint` agree.
ktlint_code_style = android_studio
# Composable functions are named like classes.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Generated code, such as the Res class for the string resources.
[**/build/**]
ktlint_standard = disabled
